      {
        "operationId": "listKeys",
        "method": "GET",
        "path": "/v1/organizations/{organization_id}/keys",
        "namespace": "admin.keys",
        "unit": "admin",
        "scope": "management",
        "idempotent": true,
        "timeoutMs": 10000,
        "idempotencyKey": false,
        "conditional": false,
        "credentials": { "actingUser": "required", "acceptsShareToken": false, "requiresSession": true, "requiresSecretKey": false, "takesNoCredential": false, "pendingInvitee": false },
        "pathParameters": [ { "name": "organization_id", "type": { "kind": "string", "format": "uuid" }, "description": "The organization." } ],
        "queryParameters": [
