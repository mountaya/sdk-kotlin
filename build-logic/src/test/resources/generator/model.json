          "data": { "type": { "kind": "ref", "name": "Key" } },
          "metadata": { "required": false, "type": { "kind": "ref", "name": "Page" } },
          "responses": [ { "status": 201, "headers": [ { "name": "Location", "required": true, "type": { "kind": "string", "format": "uri" } } ] } ]
        },
        "errors": [ { "status": 401 }, { "status": 409, "metadata": { "required": false, "type": { "kind": "ref", "name": "Page" } } } ],
        "summary": "Mint a key.",
