          { "name": "sort", "required": false, "type": { "kind": "string", "name": "ListKeysSort", "enum": ["created_at", "-created_at"], "enumNames": ["ListKeysSortCreatedAt", "ListKeysSortCreatedAtDescending"] } }
        ],
        "headerParameters": [],
        "pagination": { "sort": ["created_at", "-created_at"], "defaultSort": "-created_at" },
        "success": {
          "kind": "envelope",
          "data": { "type": { "kind": "array", "items": { "kind": "ref", "name": "Key" } } },
          "metadata": { "required": true, "type": { "kind": "ref", "name": "ListMetadata" } },
          "responses": [ { "status": 200, "headers": [] } ]
        },
        "errors": [ { "status": 403 } ],
        "summary": "List an organization's keys."
      },
      {
        "operationId": "postKey",
        "method": "POST",
        "path": "/v1/keys",
        "namespace": "admin.keys",
        "unit": "admin",
        "scope": "management",
        "idempotent": false,
        "timeoutMs": 30000,
        "idempotencyKey": true,
        "conditional": false,
        "credentials": { "actingUser": "none", "acceptsShareToken": false, "requiresSession": false, "requiresSecretKey": true, "takesNoCredential": false, "pendingInvitee": false },
        "requestBody": { "required": true, "content": [ { "mediaType": "application/json", "type": { "kind": "ref", "name": "KeyCreateParams" } } ] },
        "success": {
