        "idempotent": true,
        "timeoutMs": 30000,
        "idempotencyKey": true,
        "conditional": true,
        "credentials": { "actingUser": "required", "acceptsShareToken": false, "requiresSession": false, "requiresSecretKey": false, "takesNoCredential": false, "pendingInvitee": false },
        "pathParameters": [ { "name": "hut_id", "type": { "kind": "string", "format": "uuid" } } ],
        "requestBody": { "required": true, "content": [ { "mediaType": "application/json", "type": { "kind": "ref", "name": "Hut" } } ] },
        "success": { "kind": "envelope", "data": { "type": { "kind": "ref", "name": "Hut" } }, "responses": [ { "status": 200, "headers": [] } ] },
