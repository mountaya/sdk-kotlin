# Trail's settings (the contract's sdk/trail.yaml). Copy this file to .env beside it, which is never committed, and
# fill in what you have; a variable of the same name in your shell takes its place. See the README, Examples you can run.

# Your organization's publishable key, with the tiles, publishing and data scopes. Without it Trail shows a notice in
# place of the map and the search, and runs everything else on its demo itinerary.
MOUNTAYA_PUBLISHABLE_KEY=

# A published itinerary your key reads, shown and followed in place of the demo itinerary.
MOUNTAYA_ITINERARY_ID=

# Where the app asks for a session token, which search needs: the session server's (mise run trail:session) is
# http://10.0.2.2:8787/session from the Android emulator. Without it search stays disabled.
MOUNTAYA_SESSION_URL=
