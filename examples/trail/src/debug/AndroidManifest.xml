<?xml version="1.0" encoding="utf-8"?>
<!-- The debug build alone speaks plain HTTP, so the emulator reaches the session server on the computer's loopback at
     http://10.0.2.2:8787/session. A release build sends nothing but HTTPS. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
